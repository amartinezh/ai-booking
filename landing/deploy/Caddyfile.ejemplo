# ── Landing pública agenia.co (landing/ del repo) ──────────────────────────
# Va al final de /opt/agenia/deploy/Caddyfile del VPS de update.sh. La sirve el
# mismo Caddy desde /data/landing (la subcarpeta landing/ de su volumen de
# datos, adonde la sube landing/deploy/desplegar.sh): sin contenedor ni red
# nuevos. Requiere que el DNS de agenia.co y www.agenia.co apunte a este VPS;
# Caddy pide el certificado solo.
#
# HSTS SIN includeSubDomains: en el dominio raíz obligaría HTTPS en TODOS los
# subdominios de agenia.co, también en los que viven en otros servidores.

www.agenia.co {
	redir https://agenia.co{uri} permanent
}

agenia.co {
	root * /data/landing
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# El pulso cambia cada mañana; las fotos y estilos, casi nunca.
	header /data/* Cache-Control "public, max-age=300"
	header /assets/* Cache-Control "public, max-age=604800"
	# Los scripts del pulso viven junto a la página: no salen a internet.
	@interno path /scripts/* /deploy/* /README.md /package.json /.gitignore
	respond @interno "Not Found" 404
	# Por si alguien escribe agenia.co/login.
	redir /login https://app.hsvpanserma.agenia.co/login
	file_server
}
