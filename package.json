{
  "name": "agenia",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "lint:ci": "turbo run lint:ci"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.10",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": ">=2.0.8",
      "body-parser@2": ">=2.4.0",
      "multer": ">=2.5.0",
      "path-to-regexp@8": ">=8.4.0",
      "qs": ">=6.17.1",
      "lodash": ">=4.18.1",
      "lodash-es": ">=4.18.1",
      "form-data@4": ">=4.0.6",
      "follow-redirects": ">=1.16.2",
      "file-type@21": ">=21.3.2",
      "minimatch@9": ">=9.0.7",
      "brace-expansion@5": ">=5.0.12",
      "nanoid@3": ">=3.3.18",
      "postcss@8": ">=8.5.23",
      "source-map-js": ">=1.2.2",
      "browserslist": ">=4.28.7",
      "baseline-browser-mapping": ">=2.11.0",
      "moment": ">=2.31.0",
      "sharp": ">=0.35.5",
      "@babel/core": ">=7.29.6",
      "@grpc/grpc-js": ">=1.14.7",
      "protobufjs@7": ">=7.6.5",
      "@protobufjs/utf8": ">=1.1.1",
      "@tootallnate/once": ">=2.0.1",
      "@azure/msal-node": ">=7.1.0"
    }
  }
}
