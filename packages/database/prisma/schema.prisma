// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 🏢 MULTI-TENANT: ORGANIZACIÓN (CLÍNICA/HOSPITAL)
// -----------------------------------------------------------------------------
model Organization {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)
  logoUrl  String?

  // Línea de soporte humano de la clínica. Cuando un guardrail se dispara
  // (insulto, exceso de reintentos, off-topic), el chatbot deriva al paciente
  // a este número en vez de reiniciar la sesión. Si es null, cae al reinicio.
  supportPhone String?

  // Zona horaria IANA de la clínica (ej: "America/Bogota", "America/Mexico_City").
  // Cuando es null, los helpers de `@agenia/shared` caen al default
  // 'America/Bogota'. Permite expandir a clínicas en otras zonas sin tocar
  // código: el chatbot y el web leen este campo y lo pasan como `opts.timeZone`.
  timezone String?

  // Base de Conocimiento del Chatbot (por clínica)
  knowledgeBase String? @db.Text

  // Configuración avanzada por clínica (1:1)
  settings OrganizationSettings?

  // Configuración multi-LLM por clínica (1:1) — credenciales encriptadas
  aiProviderConfig AiProviderConfig?

  // Configuración del canal WhatsApp por clínica (1:1) — credenciales encriptadas
  whatsappConfig    WhatsappAccountConfig?
  whatsappTemplates WhatsappTemplate[]

  // Configuración de voz/audio (TTS) por clínica (1:1) — pitch, rate, voz, codec
  audioConfig OrganizationAudioConfig?

  // Facturación Global Súper Admin
  monthlyFee      String?
  lastPaymentDate DateTime?
  autoSuspend     Boolean   @default(false)

  // Relaciones Inversas (Todo el sistema)
  users                 User[]
  eps                   Eps[]
  medicalServices       MedicalService[]
  consultingRooms       ConsultingRoom[]
  slots                 ScheduleSlot[]
  appointments          Appointment[]
  clinicalRecords       ClinicalRecord[]
  patients              PatientProfile[]
  doctors               DoctorProfile[]
  interactionLogs       InteractionLog[]
  agents                AgentProfile[]
  waitlistEntries       WaitlistEntry[]
  supportTickets        SupportTicket[]
  chatSurveys           ChatSurvey[]
  epsEnrolledPatients   EpsEnrolledPatient[]
  epsEnrollmentRequests EpsEnrollmentRequest[]

  // 🪞 ESPEJO HOSPITAL (ver PLAN_ESPEJO_HOSPITAL.md) — 1:1, config del driver HIS de esta org.
  hospitalMirrorConfig HospitalMirrorConfig?
  mirrorConflictAlerts MirrorConflictAlert[]
  syncOutboxEntries    SyncOutbox[]
  syncInboxEntries     SyncInbox[]
  syncAuditEntries     SyncAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// ⚙️ CONFIGURACIONES POR ORGANIZACIÓN (extensible)
// -----------------------------------------------------------------------------
model OrganizationSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Personalización del chatbot
  botName String @default("AgenIA")

  // Tolerancia a fallos del flujo conversacional:
  // máximo de reintentos por paso antes de derivar al humano.
  maxRetriesPerStep Int @default(3)

  // Tono de voz del chatbot:
  //   FORMAL    → "usted", estructurado, viñetas A/B/C explícitas
  //   INFORMAL  → "tú", conversacional, viñetas integradas en párrafo
  communicationStyle CommunicationStyle @default(FORMAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CommunicationStyle {
  FORMAL
  INFORMAL
}

// -----------------------------------------------------------------------------
// 🔊 MULTI-TENANT: CONFIGURACIÓN DE VOZ Y AUDIO (TTS) POR CLÍNICA
// Reemplaza la configuración global hardcoded del "Gestor de Audios" del
// chatbot. Cada organización define su PROVEEDOR de voz (Google o ElevenLabs),
// el género del asistente y los parámetros/credenciales propios de cada motor,
// que se inyectan dinámicamente en cada síntesis de audio.
//
// Aislamiento NIVEL BANCA: `organizationId` es UNIQUE + FK con onDelete:Cascade.
// Una organización jamás puede leer/escribir la configuración de otra.
// Los rangos válidos de `googlePitch` (-20..20) y `googleSpeakingRate`
// (0.25..4.0) se imponen además con CHECK constraints en la migración SQL.
// -----------------------------------------------------------------------------
model OrganizationAudioConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Proveedor de voz activo. GOOGLE es el Plan B siempre disponible.
  activeProvider VoiceProvider @default(GOOGLE)

  // Género del asistente. Alimenta la selección de voz por defecto en el panel
  // (en ElevenLabs determina el voiceId sugerido masculino/femenino).
  gender VoiceGender @default(FEMENINO)

  // Códec del audio sintetizado. OGG_OPUS es el requerido por WhatsApp Cloud API.
  audioEncoding AudioEncoding @default(OGG_OPUS)

  // ── Google Cloud TTS (Plan B) ───────────────────────────────────────────
  // Tono de la voz. Rango válido de Google TTS: -20.0 a 20.0 semitonos.
  // CHECK constraint en BD: googlePitch BETWEEN -20.0 AND 20.0.
  googlePitch Float @default(0.0)

  // Velocidad de habla. Rango válido de Google TTS: 0.25x a 4.0x.
  // CHECK constraint en BD: googleSpeakingRate BETWEEN 0.25 AND 4.0.
  googleSpeakingRate Float @default(1.0)

  // Identificador de la voz de Google TTS (ej: es-US-Neural2-A).
  googleVoiceId String @default("es-US-Neural2-A")

  // ── ElevenLabs (Studio Quality) ─────────────────────────────────────────
  // API key de ElevenLabs ENCRIPTADA con AES-256-GCM (CryptoService). Nunca se
  // almacena ni se devuelve al frontend en texto plano. `null` = sin configurar.
  elevenLabsApiKey String? @db.Text

  // Voice ID de ElevenLabs (ej: qHkrJuifPpn95wK3rm2A). No es secreto.
  elevenLabsVoiceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Proveedores de Text-to-Speech soportados por la plataforma.
enum VoiceProvider {
  GOOGLE
  ELEVENLABS
}

// Género del asistente virtual (voz).
enum VoiceGender {
  MASCULINO
  FEMENINO
}

// Códecs soportados por Google Cloud TTS que exponemos a las clínicas.
// OGG_OPUS es el único compatible con notas de voz de WhatsApp; MP3 y LINEAR16
// quedan disponibles para integraciones futuras (web player, telefonía).
enum AudioEncoding {
  OGG_OPUS
  MP3
  LINEAR16
}

// -----------------------------------------------------------------------------
// 🧠 MULTI-LLM: CONFIGURACIÓN DINÁMICA POR CLÍNICA
// Permite que cada clínica elija su proveedor (Gemini, ChatGPT, Claude)
// y guarde sus credenciales encriptadas (AES-256-GCM).
// -----------------------------------------------------------------------------
model AiProviderConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Proveedor activo. NONE = la clínica todavía no configuró IA.
  activeProvider LlmProvider @default(NONE)

  // JSON serializado y luego encriptado con AES-256-GCM.
  // Estructura interna por proveedor:
  //   GEMINI   → { "apiKey": "...", "model": "gemini-2.5-flash" }
  //   CHATGPT  → { "apiKey": "...", "model": "gpt-4o-mini", "organizationId": "org_..." }
  //   CLAUDE   → { "apiKey": "...", "model": "claude-sonnet-4-6" }
  // Nunca se almacena en texto plano.
  encryptedApiConfig String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LlmProvider {
  GEMINI
  CHATGPT
  CLAUDE
  NONE
}

// -----------------------------------------------------------------------------
// 📱 CANAL WHATSAPP: CONFIGURACIÓN POR CLÍNICA
// Almacena las credenciales de la WhatsApp Business API (Meta Graph) que cada
// clínica obtiene de su panel de Meta for Developers.
// El access token NUNCA se guarda en texto plano: se encripta con AES-256-GCM.
// -----------------------------------------------------------------------------
model WhatsappAccountConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // ID interno que Meta asigna a la línea telefónica (15–17 dígitos).
  // ÚNICO en toda la plataforma: es la llave que usa el webhook entrante
  // para enrutar mensajes al tenant correcto.
  phoneNumberId String? @unique

  // ID de la WhatsApp Business Account (WABA). Informativo.
  businessAccountId String?

  // Número de display (ej. "+57 300 1234567"). Solo para mostrar al usuario.
  displayPhoneNumber String?

  // Token elegido por la clínica para validar el webhook GET de Meta.
  // ÚNICO porque cuando Meta llama a verificar, sólo conocemos este token
  // y debemos identificar a qué clínica pertenece.
  verifyToken String? @unique

  // Permanent Access Token cifrado (AES-256-GCM). Empieza por "EAA…" en claro.
  encryptedAccessToken String? @db.Text

  // App Secret de la app de Meta, cifrado (AES-256-GCM). Cuando está
  // configurado, el webhook POST exige la firma X-Hub-Signature-256 válida
  // (HMAC-SHA256 del body crudo) — sin él, cualquiera que conozca la URL
  // podría inyectar mensajes falsos al tenant. null = verificación apagada
  // (retrocompatibilidad; cae al env META_APP_SECRET si existe).
  encryptedAppSecret String? @db.Text

  // false hasta que la clínica termine de configurar y validar la conexión.
  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 📨 PLANTILLAS DE WHATSAPP (mensajes fuera de la ventana de 24 h)
// -----------------------------------------------------------------------------
//
// Meta sólo permite TEXTO LIBRE dentro de las 24 h siguientes al último mensaje
// del paciente. Fuera de esa ventana —el caso normal de un recordatorio de cita
// enviado el día anterior— hay que usar una plantilla previamente APROBADA.
//
// Las plantillas se aprueban contra la WABA de CADA clínica, así que su nombre
// e idioma son datos POR ORGANIZACIÓN: la misma plantilla lógica
// (APPOINTMENT_REMINDER) puede llamarse distinto en cada tenant.
enum WhatsappTemplateKind {
  APPOINTMENT_REMINDER
  WAITLIST_SLOT_OFFER
}

model WhatsappTemplate {
  id String @id @default(uuid())

  kind WhatsappTemplateKind

  // Nombre EXACTO tal como quedó aprobado en la WABA de la clínica.
  name String

  // Código de idioma de la plantilla aprobada (ej. 'es', 'es_CO'). Debe
  // coincidir con el de la aprobación: Meta rechaza el envío si no cuadra.
  language String @default("es")

  // La plantilla aprobada incluye un botón REQUEST_CONTACT_INFO. Es
  // informativo para el envío (el botón vive en la plantilla aprobada, no en
  // el payload), pero permite saber qué plantillas sirven para recuperar el
  // número de un paciente que lo tiene oculto.
  requestsContactInfo Boolean @default(false)

  // Permite desactivar una plantilla sin borrarla (ej. mientras Meta la
  // revisa de nuevo tras una edición).
  isActive Boolean @default(true)

  // 🏢 TENANT ISOLATION — cada clínica configura las suyas.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, kind])
  @@index([organizationId])
}

// -----------------------------------------------------------------------------
// 🔐 AUTH & CORE USER (Mínimo necesario para login)
// -----------------------------------------------------------------------------
model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     Role   @default(PATIENT)

  // Relaciones 1:1 con Perfiles Opcionales según el Rol
  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  agentProfile   AgentProfile?

  // Relación con Logs de Auditoría ("Caja Negra")
  interactionLogs InteractionLog[]

  // Tickets de soporte que reportó este usuario
  supportTickets SupportTicket[]

  // 🏢 TENANT ISOLATION
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 1. Catálogo de Aseguradoras (NUEVO)
// -----------------------------------------------------------------------------
model Eps {
  id       String  @id @default(uuid())
  name     String // Ej: 'Sura', 'Sanitas' — única POR CLÍNICA (ver @@unique)
  nit      String?
  isActive Boolean @default(true) // Para encender/apagar convenios

  // Relaciones
  patients         PatientProfile[] // Pacientes afiliados a esta EPS
  slots            ScheduleSlot[] // Cupos de agenda EXCLUSIVOS para esta EPS
  appointments     Appointment[] // Historial de citas facturadas por esta EPS
  agents           AgentProfile[] // Agentes limitados a agendar paciente de esta EPS
  waitlistEntries  WaitlistEntry[]
  enrolledPatients EpsEnrolledPatient[] // Padrón: pacientes dados de alta para agendar por esta EPS

  // 🏢 TENANT ISOLATION — obligatorio: una EPS siempre pertenece a una clínica.
  // La unicidad de name/nit es por organización: dos clínicas pueden tener
  // ambas su propia "Sura" sin chocar entre sí.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@unique([organizationId, nit])
}

// -----------------------------------------------------------------------------
// 2. Catálogo de Servicios / Especialidades (NUEVO)
// -----------------------------------------------------------------------------
model MedicalService {
  id       String  @id @default(uuid())
  name     String // Ej: 'Odontología', 'Medicina General' — único POR CLÍNICA
  isActive Boolean @default(true)

  // Relaciones
  doctors         DoctorProfile[] // Qué doctores prestan este servicio
  slots           ScheduleSlot[] // Agenda disponible para este servicio
  waitlistEntries WaitlistEntry[]

  // 🏢 TENANT ISOLATION — obligatorio: cada clínica define su propio catálogo,
  // por eso "Odontología" puede existir en varias clínicas a la vez.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
}

// 🏥 CONSULTORIO — catálogo genérico y OPCIONAL de salas/consultorios físicos de
// la clínica. Existe para dar visibilidad en el dashboard de a qué consultorio
// suele estar asignado un médico; ningún flujo de agendamiento por WhatsApp lo
// exige. Nace del espejo con HIS (ver docs/PLAN_ESPEJO_HOSPITAL.md y
// docs/drivers/cnt-sanvicente-anserma/, tabla dbo.CONSULTORIOS) pero es un
// concepto genérico del motor, no de un driver — cualquier clínica puede usarlo
// aunque no tenga espejo. `code` homologa con el código del HIS cuando aplica;
// la decisión de en qué consultorio queda una cita CONCRETA al escribir al HIS
// la resuelve cada driver en tiempo real (ver comentario en DoctorProfile).
model ConsultingRoom {
  id String @id @default(uuid())

  code     String // homólogo de CD_CODI_CONS del HIS, cuando aplica
  name     String? // homólogo de DE_DESC_CONS
  location String? // homólogo de DE_UBIC_CONS
  isActive Boolean @default(true)

  doctors DoctorProfile[]

  // 🏢 TENANT ISOLATION
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
}

// -----------------------------------------------------------------------------
// 🏥 PATIENT PROFILE (Datos Médicos y Contacto)
// -----------------------------------------------------------------------------
model PatientProfile {
  id String @id @default(uuid())

  // 🆔 IDENTIDAD DE WHATSAPP — scoped POR ORGANIZACIÓN.
  //
  // Desde el cambio de usernames de Meta (2026), el teléfono deja de venir en
  // el webhook cuando el paciente oculta su número: `whatsappId` guarda el
  // número mientras Meta lo entregue (caché de 30 días / contact book) y
  // `bsuid` el Business-scoped user ID (ej. CO.13491208655302741918), que es
  // el identificador estable y el que la API de envío espera en `recipient`.
  //
  // Ambos son POR CLÍNICA a propósito: el mismo paciente en dos clínicas son
  // dos filas con dos BSUID distintos (uno por portafolio de Meta). NO se
  // adopta el Parent BSUID (CO.ENT.*) porque su función es correlacionar al
  // mismo usuario entre portafolios vinculados — justo lo contrario del
  // aislamiento fuerte que queremos entre tenants sobre datos de salud.
  whatsappId String?
  bsuid      String?

  // Cédula única POR CLÍNICA (ver @@unique): la misma persona puede ser
  // paciente de varias clínicas, cada una con su propio PatientProfile.
  cedula      String
  fullName    String
  dateOfBirth DateTime?
  gender      String? // Ej: 'M', 'F', 'Other'
  address     String?

  // 🔌 CONEXIÓN EPS: El paciente declara su EPS base
  epsId String?
  eps   Eps?    @relation(fields: [epsId], references: [id])

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointments     Appointment[]
  clinicalRecords  ClinicalRecord[]
  informedConsents InformedConsent[]
  waitlistEntries  WaitlistEntry[]
  chatSurveys      ChatSurvey[]

  // 🏢 TENANT ISOLATION — obligatorio: todo paciente pertenece a una clínica.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, cedula])
  @@unique([organizationId, bsuid])
  @@index([organizationId, whatsappId])
}

// -----------------------------------------------------------------------------
// 🩺 DOCTOR PROFILE (Datos Profesionales Médicos)
// -----------------------------------------------------------------------------
model DoctorProfile {
  id String @id @default(uuid())

  // Cédula y Tarjeta Profesional únicas POR CLÍNICA (ver @@unique): un médico
  // puede trabajar en varias clínicas, cada una con su propio DoctorProfile.
  cedula         String
  fullName       String
  medicalLicense String? // Tarjeta Profesional
  phone          String?
  isActive       Boolean @default(true)

  // 🪞 ESPEJO HOSPITAL: si la organización usa HospitalMirrorConfig, este médico
  // puede existir en AgenIA (importado del HIS) sin aceptar todavía reservas por
  // WhatsApp — activación manual y gradual del piloto (ver PLAN_ESPEJO_HOSPITAL.md
  // §5.3/§5.4). Orgs sin espejo: default true no cambia el comportamiento actual.
  whatsappBookingEnabled Boolean @default(true)

  // 🔌 CONEXIÓN SERVICIO: La especialidad deja de ser String libre
  serviceId String?
  service   MedicalService? @relation(fields: [serviceId], references: [id])

  // 🏥 CONSULTORIO HABITUAL — opcional e informativo (ver ConsultingRoom). NO es
  // la fuente de verdad de en qué consultorio queda una cita concreta: eso lo
  // resuelve cada driver de espejo en el momento de escribir al HIS (para
  // cnt-sanvicente-anserma, del turno del médico ese día — ver
  // docs/drivers/cnt-sanvicente-anserma/MAPEO_HIS.md §2.1). Esto es solo para
  // mostrarlo en el dashboard de AgenIA.
  consultingRoomId String?
  consultingRoom   ConsultingRoom? @relation(fields: [consultingRoomId], references: [id])

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relación con el motor de turnos
  slots           ScheduleSlot[]
  agents          AgentProfile[] // Agentes limitados a gestionar la agenda de este doctor
  clinicalRecords ClinicalRecord[]
  addendums       Addendum[]
  waitlistEntries WaitlistEntry[] // Pacientes en lista de espera que pidieron a este médico

  // 🏢 TENANT ISOLATION — obligatorio: todo médico pertenece a una clínica.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, cedula])
  @@unique([organizationId, medicalLicense])
}

// -----------------------------------------------------------------------------
// 3. Agenda Física de Disponibilidad (NUEVO MOTOR)
// -----------------------------------------------------------------------------
model ScheduleSlot {
  id String @id @default(uuid())

  startTime   DateTime
  endTime     DateTime
  isAvailable Boolean  @default(true)

  // Quién atiende en este bloque
  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id])

  // Qué servicio se está prestando
  serviceId String
  service   MedicalService @relation(fields: [serviceId], references: [id])

  // Opcional: ¿Este hueco es exclusivo para pacientes de una EPS en particular?
  allowedEpsId String?
  allowedEps   Eps?    @relation(fields: [allowedEpsId], references: [id])

  // Relación 1:1 -> Si se ocupa, aquí está la cita. (Si es null, está libre)
  appointment Appointment?

  // 🏢 TENANT ISOLATION — obligatorio: todo cupo pertenece a una clínica
  // (coincide siempre con la del médico que atiende el bloque).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No podemos tener slots duplicados para el mismo médico a la misma hora exacta
  @@unique([doctorId, startTime, endTime])
  @@index([organizationId])
}

// -----------------------------------------------------------------------------
// 📅 APPOINTMENTS (Citas Médicas Evolucionada a HIS)
// -----------------------------------------------------------------------------
model Appointment {
  id               String            @id @default(uuid())
  status           AppointmentStatus @default(SCHEDULED)
  attendanceStatus AttendanceStatus  @default(PENDING) // NUEVO: Control de asistencia
  reason           String?

  // 🔌 CONEXIÓN AL SLOT: Ya no guardamos la 'fecha', apuntamos al slot real preconstruido.
  scheduleSlotId String       @unique
  scheduleSlot   ScheduleSlot @relation(fields: [scheduleSlotId], references: [id])

  // A quién se atiende
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id])

  // 🔌 CONEXIÓN EPS FACTURACIÓN: Qué EPS autorizó y cubrirá este costo.
  epsId String?
  eps   Eps?    @relation(fields: [epsId], references: [id])

  // 🔌 EHR: Historia clínica asociada a esta cita específica. (1:1 opcional hasta que se crea)
  clinicalRecord ClinicalRecord?

  // 🏢 TENANT ISOLATION — obligatorio: toda cita pertenece a una clínica
  // (coincide siempre con la del paciente y la del cupo).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // ⏰ RECORDATORIO ENVIADO — idempotencia del cron de recordatorios.
  // NULL = nunca se ha enviado recordatorio para esta cita.
  // DateTime = momento UTC en que el cron disparó el WhatsApp con éxito.
  reminderSentAt DateTime?

  metaLog   Json?
  createdAt DateTime          @default(now())
  origin    AppointmentOrigin @default(WHATSAPP)

  @@index([organizationId])
}

enum AppointmentOrigin {
  MANUAL
  WHATSAPP
  MIRROR // Creada/reflejada desde el HIS de un hospital (ver PLAN_ESPEJO_HOSPITAL.md)
}

enum Role {
  PATIENT
  DOCTOR
  ORG_ADMIN
  SUPER_ADMIN
  BOOKING_AGENT
  GENERAL_OBSERVER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// -----------------------------------------------------------------------------
// 🕵️ AUDITORÍA "CAJA NEGRA" (Logs de Chatbot y Demandas Fallidas)
// -----------------------------------------------------------------------------
model InteractionLog {
  id            String  @id @default(uuid())
  whatsappId    String // Identificador de WhatsApp/Facebook del remitente
  status        String // Ej: "SUCCESS", "FAILED", "ABANDONED"
  failureReason String? // Ej: "UNINTELLIGIBLE_AUDIO", "SERVICE_NOT_FOUND", "NO_AGENDA"

  // El rastro de la conversación para recuperación manual
  userMessage String? // Lo que transcribió Gemini o escribió el usuario
  botReply    String? // Lo que Vicente le contestó

  // 🔥 Superpoder NoSQL dentro de Postgres
  metadata Json? // Guarda info inferida (EPS, servicios) para Business Intelligence

  createdAt DateTime @default(now())

  // Relación opcional por si el usuario que falla ya tiene un PatientProfile/User
  patientId String?
  patient   User?   @relation(fields: [patientId], references: [id])

  // 🏢 TENANT ISOLATION — nullable A PROPÓSITO: hay eventos que se loguean
  // antes de poder resolver el tenant (webhooks descartados sin
  // phone_number_id, errores de outbound sin org). Toda vista de clínica
  // DEBE filtrar por organizationId; las filas NULL solo son visibles para
  // diagnóstico de plataforma (SUPER_ADMIN).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  contactedAt  DateTime? // Cuándo el funcionario contactó al paciente
  contactedBy  String? // Email/nombre del funcionario que contactó
  contactNotes String?   @db.Text // Resultado del contacto
}

// -----------------------------------------------------------------------------
// 🏢 AGENT PROFILE (Agendador Humano con Scopes)
// -----------------------------------------------------------------------------
model AgentProfile {
  id String @id @default(uuid())

  fullName String
  phone    String?
  isActive Boolean @default(true)

  // 🔌 SCOPE: ¿Este Agente está limitado a atender pacientes de una EPS específica?
  epsId String?
  eps   Eps?    @relation(fields: [epsId], references: [id])

  // 🔌 SCOPE: ¿Este Agente está limitado a agendar citas de un Doctor en particular?
  doctorId String?
  doctor   DoctorProfile? @relation(fields: [doctorId], references: [id])

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 🏢 TENANT ISOLATION — obligatorio: todo agente agenda para UNA clínica.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 📋 ELECTRONIC HEALTH RECORD (EHR - Historia Clínica Electrónica)
// -----------------------------------------------------------------------------
model ClinicalRecord {
  id String @id @default(uuid())

  // Motivo de Consulta y Anamnesis
  chiefComplaint String @db.Text
  currentIllness String @db.Text

  // Examen Físico y Notas
  physicalExam   String? @db.Text
  evolutionNotes String? @db.Text

  // Relaciones
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id])

  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id])

  // Componentes de la HC
  vitalSigns    VitalSigns?
  diagnoses     Diagnosis[]
  prescriptions MedicalPrescription[]

  // 🏢 TENANT ISOLATION — obligatorio: toda historia clínica pertenece a una
  // clínica y la API filtra CADA operación por este campo (PHI).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  status       RecordStatus @default(DRAFT)
  recordNumber Int          @default(autoincrement())

  signature DigitalSignature?
  addendums Addendum[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model VitalSigns {
  id String @id @default(uuid())

  bloodPressure String? // Ej: "120/80"
  heartRate     Int? // lpm
  temperature   Float? // °C
  weight        Float? // kg
  height        Float? // cm
  oxygenSat     Int? // %

  clinicalRecordId String         @unique
  clinicalRecord   ClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)
}

model Diagnosis {
  id String @id @default(uuid())

  code        String? // Para futuro soporte CIE-10 cruzado
  description String
  isMain      Boolean @default(true) // Diagnóstico Principal vs Secundario

  clinicalRecordId String
  clinicalRecord   ClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)
}

model MedicalPrescription {
  id String @id @default(uuid())

  medication String
  dose       String
  frequency  String
  duration   String
  notes      String?

  clinicalRecordId String
  clinicalRecord   ClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)
}

enum AttendanceStatus {
  PENDING
  ATTENDED
  NO_SHOW
}

// -----------------------------------------------------------------------------
// 🔐 LEGAL & COMPLIANCE (HealthTech Colombia)
// -----------------------------------------------------------------------------

enum RecordStatus {
  DRAFT
  SIGNED
  LOCKED
}

enum ConsentType {
  DATA_TREATMENT
  MEDICAL_PROCEDURE
}

enum ConsentStatus {
  ACCEPTED
  REVOKED
}

model DigitalSignature {
  id            String   @id @default(uuid())
  userId        String // El médico que firmó
  ipAddress     String?
  timestamp     DateTime @default(now())
  hashedContent String // Hash SHA-256 integrando historial y sello de tiempo

  // Relaciones (Debe pertenecer a un ClinicalRecord O a un Addendum)
  clinicalRecordId String?         @unique
  clinicalRecord   ClinicalRecord? @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)

  addendumId String?   @unique
  addendum   Addendum? @relation(fields: [addendumId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Addendum {
  id      String @id @default(uuid())
  content String @db.Text // Nota aclaratoria

  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id])

  clinicalRecordId String
  clinicalRecord   ClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)

  signature DigitalSignature?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InformedConsent {
  id        String        @id @default(uuid())
  type      ConsentType
  status    ConsentStatus @default(ACCEPTED)
  version   String // Versión de los términos de datos (ej: "v1.2")
  ipAddress String?
  userAgent String?

  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// ⏳ LISTA DE ESPERA (WAITLIST)
// -----------------------------------------------------------------------------
model WaitlistEntry {
  id String @id @default(uuid())

  // Quién espera
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Qué busca
  serviceId String
  service   MedicalService @relation(fields: [serviceId], references: [id])

  // Filtro EPS (null = acepta cualquier slot universal)
  epsId String?
  eps   Eps?    @relation(fields: [epsId], references: [id])

  // Médico preferido (opcional): el paciente pidió un doctor específico.
  // null = acepta cualquier médico del servicio.
  preferredDoctorId String?
  preferredDoctor   DoctorProfile? @relation(fields: [preferredDoctorId], references: [id])

  // Estado de la entrada
  status     WaitlistStatus @default(WAITING)
  notifiedAt DateTime?
  expiresAt  DateTime?

  // Canal de contacto
  whatsappId String

  // Datos del slot pendiente cuando status = NOTIFIED
  // Estructura: { pendingSlotId, doctorName, slotDate }
  metadata Json?

  // 🏢 TENANT ISOLATION
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // 🪞 ESPEJO HOSPITAL: presente cuando esta entrada nació de un conflicto de
  // agenda contra el HIS de un hospital (ver PLAN_ESPEJO_HOSPITAL.md §5.1/§7).
  mirrorConflictAlert MirrorConflictAlert?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, serviceId, status])
  @@index([whatsappId, status])
  @@index([preferredDoctorId])
}

enum WaitlistStatus {
  WAITING // Esperando que se libere un cupo
  NOTIFIED // Le avisamos, esperando confirmación SI/NO
  CONFIRMED // Tomó el cupo (se convirtió en Appointment)
  EXPIRED // No respondió en 30 minutos
  CANCELLED // Salió voluntariamente o rechazó el cupo
}

// -----------------------------------------------------------------------------
// 🛟 HELP DESK / SOPORTE DE TICKETS INTERNO
// -----------------------------------------------------------------------------
model SupportTicket {
  id          String              @id @default(uuid())
  title       String
  description String              @db.Text
  status      SupportTicketStatus @default(OPEN)

  // Marcas temporales del ciclo de vida del ticket
  startedAt  DateTime?
  resolvedAt DateTime?

  // Nota/Respuesta del equipo de soporte (Super Admin)
  resolutionNote String? @db.Text

  // Quién reporta
  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  // 🏢 TENANT ISOLATION (clínica del reportante)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([reporterId, status])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// -----------------------------------------------------------------------------
// 🩻 SYSTEM LOG — Auditoría y trazabilidad centralizada (cross-tenant)
// Diseñado para crecer mucho. Solo visible para SUPER_ADMIN en el dashboard.
// -----------------------------------------------------------------------------
model SystemLog {
  id      String   @id @default(uuid())
  level   LogLevel
  action  String // Ej: 'USER_LOGIN', 'DOCTOR_DELETED', 'UNHANDLED_EXCEPTION'
  message String   @db.Text

  // Contexto rico: stack trace, body de la request, IP, headers, etc.
  metadata Json?

  userId         String?
  organizationId String?

  createdAt DateTime @default(now())

  // Índices críticos para listado y dashboard de "últimas 24h".
  @@index([createdAt])
  @@index([level, createdAt])
  @@index([action])
}

enum LogLevel {
  EVENT
  WARNING
  ERROR
}

// -----------------------------------------------------------------------------
// 🧾 GLOBAL AUDIT LOG — Bitácora inmutable a nivel plataforma (Super Admin)
//
// A diferencia de InteractionLog (que vive DENTRO del tenant y se borra con él)
// o de SystemLog (logging operacional), esta tabla es un registro legal
// append-only que debe SOBREVIVIR al borrado de una clínica.
//
// Por eso NO tiene llave foránea hacia Organization: guardamos organizationId
// y organizationName como escalares planos. Cuando el Super Admin purga una
// clínica, el FK desaparecería junto con la org; aquí, en cambio, queda la
// evidencia inmutable de quién purgó qué, cuándo y desde dónde.
// -----------------------------------------------------------------------------
model GlobalAuditLog {
  id      String            @id @default(uuid())
  action  GlobalAuditAction
  // Texto humano-legible del evento (lo que se muestra en el dashboard legal).
  message String            @db.Text

  // Actor que ejecutó la acción (no es FK: el actor podría ser eliminado luego).
  actorId    String?
  actorEmail String?

  // Objetivo de la acción. Escalares planos a propósito (sin relación) para
  // que la entrada sobreviva al hard delete del tenant.
  organizationId   String?
  organizationName String?

  // Trazabilidad de la request (IP, user agent) y conteos purgados, etc.
  ipAddress String?
  metadata  Json?

  // Inmutable por convención: sólo se inserta, nunca se actualiza ni borra.
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([organizationId])
}

enum GlobalAuditAction {
  ORGANIZATION_PURGED
  ORGANIZATION_CREATED
  ORGANIZATION_SUSPENDED
}

// -----------------------------------------------------------------------------
// ⭐ ENCUESTA DE SATISFACCIÓN POST-CHAT (CSAT)
//
// Al cerrar CUALQUIER flujo conversacional (cita agendada, ingreso a lista de
// espera, error técnico o cierre por insultos) el bot genera un registro aquí
// y envía por WhatsApp un enlace ÚNICO de un solo uso: https://.../encuesta/{id}.
//
// Seguridad: el `id` (UUID) ES el token del enlace. La página web sólo lo
// renderiza si isUsed == false y expiresAt > now(); de lo contrario redirige al
// Home. El POST de calificación vuelve a verificar ambas condiciones (regla de
// oro) y marca isUsed = true para que el enlace no se pueda reutilizar.
// -----------------------------------------------------------------------------
model ChatSurvey {
  // El UUID es a la vez la PK y el token público del enlace.
  id String @id @default(uuid())

  // 👤 A quién se le envió. Opcional: en cierres por insulto o error técnico
  // puede que el paciente nunca llegara a identificarse con su cédula.
  patientId String?
  patient   PatientProfile? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  // 🏢 TENANT ISOLATION
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // 🤖 Contexto auto-llenado por el bot al cerrar el flujo.
  chatSummary      String?          @db.Text
  resolutionStatus ResolutionStatus

  // ⭐ Llenado por el usuario en la web. null hasta que califica.
  rating   Int? // 1 a 5
  feedback String? @db.Text

  // 🔐 Seguridad del enlace de un solo uso.
  isUsed    Boolean  @default(false)
  expiresAt DateTime // Típicamente now() + 24h

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // El cron/limpieza y la búsqueda del token se apoyan en estos índices.
  @@index([organizationId, createdAt])
  @@index([isUsed, expiresAt])
}

enum ResolutionStatus {
  BOOKED // El paciente agendó su cita con éxito
  QUEUED // El paciente quedó en lista de espera
  BLOCKED_INSULT // La sesión se cerró por lenguaje abusivo
  SYSTEM_ERROR // Cierre por error técnico / exceso de reintentos
  CANCELLED // El paciente canceló una cita existente con éxito
}

// -----------------------------------------------------------------------------
// 🪪 PADRÓN EPS: PACIENTES DADOS DE ALTA
//
// Regla de negocio: un paciente solo puede AGENDAR POR EPS si su cédula figura
// en este padrón (cargado por la clínica vía CSV en /dashboard/padron). Las
// citas "Particular" (pago directo) NO pasan por esta tabla.
//
// La cédula es única POR CLÍNICA (multi-tenant): la misma persona puede estar
// dada de alta en varias clínicas, cada una con su propia fila y su propia EPS.
// Un re-import del CSV hace upsert por (organizationId, cedula), de modo que
// un cambio de EPS del paciente se refleja re-importando el padrón.
// -----------------------------------------------------------------------------
model EpsEnrolledPatient {
  id String @id @default(uuid())

  cedula      String
  fullName    String
  phone       String?
  email       String?
  dateOfBirth DateTime?
  gender      String? // 'M', 'F', 'OTRO'
  address     String?

  // Baja lógica: permite retirar a un paciente del padrón sin perder trazabilidad.
  isActive Boolean @default(true)

  // EPS por la que el paciente está autorizado a agendar.
  epsId String
  eps   Eps    @relation(fields: [epsId], references: [id], onDelete: Cascade)

  // 🏢 TENANT ISOLATION — obligatorio: el padrón es por clínica.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, cedula])
  @@index([organizationId, epsId])
}

// -----------------------------------------------------------------------------
// 📨 SOLICITUDES DE ALTA (revisión ciudadana)
//
// Cuando el chatbot rechaza un agendamiento por EPS porque la cédula no está
// en el padrón, remite al paciente a un formulario público
// (/solicitud-alta/{orgId}) donde puede argumentar por qué debería estar dado
// de alta. Esta tabla SOLO registra esas revisiones; el alta efectiva se hace
// re-importando el padrón (o corrigiéndolo) desde el dashboard.
// -----------------------------------------------------------------------------
model EpsEnrollmentRequest {
  id String @id @default(uuid())

  cedula   String
  fullName String
  phone    String?
  epsName  String? // Nombre de la EPS que el ciudadano dice tener (texto informativo)
  message  String  @db.Text // Argumento/reclamo del ciudadano

  status     EnrollmentRequestStatus @default(PENDING)
  reviewedAt DateTime?

  // 🏢 TENANT ISOLATION
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, createdAt])
}

enum EnrollmentRequestStatus {
  PENDING // Radicada, sin revisar
  REVIEWED // Un funcionario ya la revisó
}

// -----------------------------------------------------------------------------
// 📡 MONITOR DE SERVICIOS EXTERNOS (Google / Meta) — incidentes
// -----------------------------------------------------------------------------
// El monitor de fondo (MonitorCron, MODO A) NO guarda cada check: solo escribe
// una fila cuando un servicio TRANSICIONA de UP a DOWN/DEGRADED (apertura) y la
// cierra (resolvedAt) cuando se recupera. Cada fila = un incidente completo.
// El monitoreo en vivo (MODO B) es 100% efímero y NUNCA toca esta tabla.
model ServiceIncident {
  id         String @id @default(uuid())
  serviceKey String // 'gemini', 'tts', 'meta'
  status     String // 'DOWN' o 'DEGRADED' (nunca UP — solo guardamos fallos)

  // Datos del primer check fallido (apertura del incidente).
  startedAt    DateTime @default(now())
  errorMessage String?  @db.Text
  errorCode    String? // 'TIMEOUT', 'AUTH', '5XX', etc. (para agrupar)
  httpStatus   Int?
  latencyMs    Int? // latencia del check que disparó el incidente

  // Cierre del incidente (cuando el servicio se recupera). null = aún abierto.
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceKey, startedAt])
  @@index([resolvedAt, startedAt])
  @@index([startedAt])
}

// =============================================================================
// 🪞 ESPEJO HOSPITAL — motor genérico de sincronización con HIS externos.
// Arquitectura y patrón de drivers: ver docs/PLAN_ESPEJO_HOSPITAL.md.
// Nada aquí debe referenciar un HIS específico (ni nombres de tabla ni
// formatos de un proveedor) — eso vive en el driver de cada organización,
// fuera del monorepo de AgenIA propiamente dicho (apps/mirror-agent).
// =============================================================================

// -----------------------------------------------------------------------------
// Configuración del espejo por organización (1:1). La bandera `enabled` y el
// `driverKey` que selecciona qué implementación de HisDriver habla con el HIS
// de esa organización.
// -----------------------------------------------------------------------------
model HospitalMirrorConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false) // 🚩 LA bandera

  // 🔌 Qué driver habla con el HIS de esta organización (ej. "cnt-sanvicente-anserma").
  // Sin este campo el motor no sabría con qué implementación conectar.
  driverKey String

  // Identidad del agente on-premise: solo se guarda el HASH del token (SHA-256);
  // el secreto en claro se muestra una única vez al crearlo/rotarlo.
  agentTokenHash String?

  // Payload de configuración PROPIO del driver (nombre de catálogo/BD, endpoints,
  // flags...) — cada driver define su propia forma; el motor solo lo pasa sin
  // interpretarlo.
  driverConfig Json?

  // Versión y contenido del mapeo de tablas/campos acordado en la Fase 0 de ESE driver.
  mappingVersion Int   @default(1)
  mappingJson    Json?

  // Interruptor de emergencia por dirección — independiente de `enabled`.
  pushEnabled Boolean @default(true) // AgenIA → HIS
  pullEnabled Boolean @default(true) // HIS → AgenIA

  // Observabilidad del agente on-premise.
  lastHeartbeatAt DateTime?
  lastPushCursor  BigInt    @default(0)

  // 🔔 Alertas de conflicto (doble-cupo → WaitlistEntry): configurable, se puede
  // apagar sin tocar código. Ver PLAN_ESPEJO_HOSPITAL.md §5.1/§7.
  conflictAlertsEnabled Boolean @default(true)
  agendadorWhatsapp     String? // número E.164 del agendador responsable
  agendadorEmail        String? // correo del agendador responsable

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Alerta multicanal (WhatsApp + email + in-app) cuando un conflicto de agenda
// contra el HIS manda una cita a lista de espera. 1:1 con la WaitlistEntry que
// lo originó.
// -----------------------------------------------------------------------------
model MirrorConflictAlert {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  waitlistEntryId String        @unique
  waitlistEntry   WaitlistEntry @relation(fields: [waitlistEntryId], references: [id])

  whatsappSentAt DateTime? // null = no enviado / error
  emailSentAt    DateTime?
  seenByStaffAt  DateTime? // marcado como visto en el dashboard por el agendador

  createdAt DateTime @default(now())

  @@index([organizationId, seenByStaffAt])
}

// -----------------------------------------------------------------------------
// Outbox transaccional (AgenIA → HIS). Las filas las inserta el trigger
// fn_sync_outbox() (ver migración SQL manual), NUNCA código de aplicación
// directamente — así ningún escritor (API, web, seeds, SQL manual) se escapa.
// Prisma lo modela para que el módulo mirror pueda leerlo y marcar `deliveredAt`.
// -----------------------------------------------------------------------------
model SyncOutbox {
  seq            BigInt       @id @default(autoincrement())
  // ⚠️ dbgenerated (NO @default(uuid())): esta fila SIEMPRE se crea desde el
  // trigger fn_sync_outbox() con INSERT SQL crudo, que nunca pasa por Prisma
  // Client — @default(uuid()) es un default de capa de aplicación y habría
  // dejado la columna NULL. Confirmado con una prueba real: ver Fase 1.
  eventId        String       @unique @default(dbgenerated("gen_random_uuid()"))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  entityType     String // 'SLOT' | 'DOCTOR' | 'APPOINTMENT' | 'PATIENT' | 'SERVICE' | 'EPS'
  entityId       String
  op             String // 'INSERT' | 'UPDATE' | 'DELETE'
  payload        Json // fila completa serializada (NEW u OLD) — formato canónico AgenIA
  origin         String       @default("LOCAL") // 'LOCAL' | 'MIRROR' (anti-eco)
  createdAt      DateTime     @default(now())
  deliveredAt    DateTime? // null = pendiente
  attempts       Int          @default(0)
  deadLettered   Boolean      @default(false)

  // Backoff exponencial entre reintentos. NULL = entregable ya (nunca se ha
  // intentado, o el intento anterior no llego a fallar). Cuando el agente
  // reporta un fallo, se corre hacia adelante 2^intentos segundos con techo
  // de 5 minutos: sin esto, un evento que el HIS rechaza siempre se
  // reintentaria en cada vuelta del agente y saturaria el log y la BD.
  nextAttemptAt  DateTime?

  @@index([organizationId, seq])
  // Cubre la consulta caliente del dispatcher: pendientes de una organizacion
  // en orden de seq. El indice parcial equivalente con el predicado completo
  // (incluido deadLettered) vive en prisma/sql/, porque Prisma no expresa
  // indices parciales en su DSL.
  @@index([organizationId, entityType, entityId, seq])
}

// -----------------------------------------------------------------------------
// Idempotencia de eventos ENTRANTES (agente → POST /mirror/changes). Cada
// event_id que el driver reporta se registra aquí antes de aplicarse; un
// reintento con el mismo event_id no se vuelve a aplicar.
// -----------------------------------------------------------------------------
model SyncInbox {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  eventId        String       @unique
  entityType     String
  appliedAt      DateTime     @default(now())

  @@index([organizationId, appliedAt])
}

// -----------------------------------------------------------------------------
// Auditoría append-only de toda operación del motor de espejo (ambas
// direcciones). Nunca se actualiza ni se borra una fila existente.
// -----------------------------------------------------------------------------
model SyncAudit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  direction      String // 'OUTBOUND' (AgenIA→HIS) | 'INBOUND' (HIS→AgenIA)
  entityType     String
  entityId       String?
  op             String // INSERT | UPDATE | DELETE | CANCEL
  outcome        String // OK | CONFLICT | ERROR | DEAD_LETTER
  detail         String?      @db.Text
  eventId        String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([eventId])
}
