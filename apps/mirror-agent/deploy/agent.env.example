# Config del agente — copiar a /etc/agenia-mirror-agent/agent.env en la VM,
# permisos 0600, propietario mirroragent. NUNCA commitear el archivo real
# (solo este .example, sin secretos) — ver PLAN_ESPEJO_HOSPITAL.md §9.

# --- Motor genérico (obligatorios) ---
MIRROR_API_URL=https://api.agenia.example.com
MIRROR_AGENT_TOKEN=                      # generado al crear el HospitalMirrorConfig de esta org — se muestra UNA sola vez
MIRROR_DRIVER_KEY=cnt-sanvicente-anserma
MIRROR_DRIVER_VERSION=0.1.0-fase1
MIRROR_POLL_INTERVAL_MS=5000
MIRROR_HEARTBEAT_INTERVAL_MS=60000

# Reconciliación (capa 5 del plan §6): contrasta la agenda ENTERA del hospital
# contra la de AgenIA y reporta las diferencias. Es lo único que detecta la
# deriva silenciosa — un cambio hecho mientras el agente estaba caído, una fila
# tocada a mano en el HIS. Una vez al día basta: lee la agenda completa.
MIRROR_RECONCILE_INTERVAL_MS=86400000
MIRROR_RECONCILE_DELAY_MS=120000     # espera antes de la primera, tras arrancar
MIRROR_RECONCILE_DIAS=90             # ventana hacia adelante

# --- Agenda del hospital (Fase 2) ---
# La agenda de AgenIA pasa a ser la del hospital: el agente lee TURNOS_MEDICOS,
# divide los bloques en cupos y los sube. Se enciende por organización en la
# base (`HospitalMirrorConfig.availabilityMode`: OFF / SHADOW / ON), no aquí —
# esto solo regula el ritmo.
#
# La agenda cercana se repasa seguido porque duele ya (un turno cancelado para
# mañana tiene que dejar de venderse hoy); el barrido completo va a +13 meses
# —el hospital tiene reservas hasta 12 meses adelante— pero solo una vez al día.
MIRROR_AVAILABILITY_INTERVAL_MS=900000     # repaso cercano: cada 15 min
MIRROR_AVAILABILITY_DIAS_CERCANOS=14
MIRROR_AVAILABILITY_COMPLETA_MS=86400000   # barrido completo: una vez al día
MIRROR_AVAILABILITY_DIAS=400
MIRROR_AVAILABILITY_DELAY_MS=30000         # espera antes del primer repaso

# Estado local del agente (cursor de detección + idempotencia). DEBE ser
# persistente: el cursor es una FOTO del HIS, no una marca de tiempo, y
# perderla en un reinicio deja al agente ciego a todo lo que pasó mientras
# estuvo caído. Por defecto cae en `data/` bajo el WorkingDirectory del
# servicio, que es el único directorio escribible de la unidad systemd.
# MIRROR_STATE_FILE=/opt/agenia-mirror-agent/data/state.json

# --- Driver CNT-Anserma (conexión al SQL Server del hospital) ---
# Estos NO los lee config.ts genérico — el driver los recibe vía el
# `driverConfig` que HospitalMirrorConfig.driverConfig devuelve en el
# handshake (ver mirror-dispatch.service.ts). Se listan aquí solo como
# referencia de qué datos hace falta tener a mano antes de crear esa fila:
#   server:   192.168.1.16
#   port:     1433
#   catalog:  PRUEBAS   (cambiar a ESEHSVP cuando el driver esté listo para producción)
#   user:     agenia_sync
#   password: <el que se generó al correr AGENIA_SYNC_SETUP.sql>
