[Unit]
Description=AgenIA Mirror Agent (driver: cnt-sanvicente-anserma)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mirroragent
Group=mirroragent
WorkingDirectory=/opt/agenia-mirror-agent

# Config sensible: NUNCA en el .service ni en un .env versionado. Se sirve
# como archivo protegido 0600, propiedad de mirroragent, fuera del repo.
# Ver docs/PLAN_ESPEJO_HOSPITAL.md §9 Seguridad.
EnvironmentFile=/etc/agenia-mirror-agent/agent.env

# `/usr/bin/env node` y NO `/usr/bin/node`: la ruta del intérprete depende de
# cómo se instaló Node y quemarla rompe el arranque con `status=203/EXEC`, un
# error que no menciona a Node por ninguna parte. El paquete de Debian/Ubuntu
# puede dejar el binario en `/usr/bin/nodejs`, y el tarball oficial lo instala
# en `/usr/local/bin/node`. `env` lo resuelve por PATH (systemd incluye
# /usr/local/bin y /usr/bin) y acepta la forma porque es una ruta absoluta.
#
# El único caso que `env` NO cubre es que exista `nodejs` pero no `node`; por
# eso INSTALACION_AGENTE_VPS.md §5 obliga a comprobar `command -v node` antes
# de instalar esta unidad.
ExecStart=/usr/bin/env node /opt/agenia-mirror-agent/dist/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agenia-mirror-agent

# Endurecimiento — el agente no necesita más que esto: leer su propio config,
# hablar HTTPS saliente, y hablar T-SQL saliente hacia 192.168.1.16.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/agenia-mirror-agent/data

[Install]
WantedBy=multi-user.target
