# =============================================================================
# .env (raíz) — credenciales de la infraestructura Docker LOCAL.
#
# Copia este archivo a `.env` y rellénalo, o deja que `./scripts/up.sh` lo
# genere solo (crea la contraseña con `openssl rand -hex 16`).
#
# `docker compose` carga ESTE archivo automáticamente para resolver los
# ${...} de docker-compose.yml. Por eso vive en la raíz y no en apps/.
#
# ⚠️ `.env` está en .gitignore y NUNCA debe commitearse. La contraseña real
#    solo existe en tu máquina. Producción no usa este archivo: usa
#    `.env.production` en el VPS (ver docs/INSTALACION_VPS.md).
# =============================================================================

# Usuario dueño de la base local.
POSTGRES_USER=admin

# Contraseña de Postgres. Genera una con:  openssl rand -hex 16
POSTGRES_PASSWORD=

# Nombre de la base de datos.
POSTGRES_DB=agenia

# Contraseña SA del SQL Server mock del HIS (solo con `up.sh --his-mock`).
# Debe cumplir la política de complejidad de SQL Server.
MIRROR_HIS_MOCK_SA_PASSWORD=
